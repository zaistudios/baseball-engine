{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // vite/client is here for `import.meta.env.DEV`, which gates the replay
    // preview hook in main.ts. Vite constant-folds it to false and drops the
    // branch, so the hook cannot reach the one-file demo build.
    "types": ["vitest/globals", "node", "vite/client"],

    // Node 24 strips types and runs src/cli/play.ts directly, but its resolver
    // needs the real .ts extension on imports. Safe with noEmit.
    "allowImportingTsExtensions": true,

    // The build gate. This is the load-bearing claim under the stack choice:
    // an agent cannot ship a change that does not type. Do not loosen these
    // to make a failing build pass - fix the code.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],

  // ⚠️ src/web IS THE ROGUELIKE, AND IT IS FROZEN. Basedball is the project;
  // the gauntlet through three eras is a mode somebody may build later, and
  // until then it does not get a vote on what compiles.
  //
  // It came out of the build on 2026-09-16 with its render modules — plot,
  // overhead, swing and sprites, which Basedball's fielding and replay sit on
  // — moved into src/game/ where their only caller now lives. What is left in
  // src/web is the roguelike's own screens, and they still import those four
  // from beside themselves, so THE FOLDER NO LONGER TYPES. That is expected
  // and it is why it is excluded rather than half-fixed: reviving it means
  // pointing those four imports at ../game/ and deciding what it shares, which
  // is a decision for the day somebody wants the mode, not a maintenance tax
  // on every build between now and then.
  "exclude": ["src/web"]
}
