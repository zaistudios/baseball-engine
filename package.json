{
  "name": "baseball-engine",
  "version": "1.15.4",
  "private": true,
  "type": "module",
  "description": "Basedball — a baseball game in one html file.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.include=src/**/*.ts --coverage.exclude=src/**/__tests__/**",
    "check": "npm run typecheck && npm run test",
    "dev": "vite --open /game.html",
    "build": "vite build",
    "game": "vite --open /game.html",
    "sim": "node scripts/balance.ts",
    "export": "npm run check && vite build && node scripts/bundle.mjs",
    "release": "npm run export && node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
